# Production must use the real HTTPS origin. No trailing slash.
# Render provides RENDER_EXTERNAL_URL automatically if PUBLIC_ORIGIN is omitted.
NODE_ENV=production
PORT=3000
PUBLIC_ORIGIN=https://your-game.onrender.com
# Local development does not need this file or secrets.
# Optional public endpoint only when deliberately splitting frontend/backend:
# VITE_SERVER_URL=https://your-backend.onrender.com
