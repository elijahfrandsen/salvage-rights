{
  "name": "salvage-rights",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "build": "tsc -p tsconfig.server.json && vite build --config apps/client/vite.config.ts",
    "start": "node dist/apps/server/src/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check apps packages scripts tests *.json *.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "load": "node --import tsx scripts/load.ts",
    "balance": "node --import tsx scripts/balance.ts"
  },
  "dependencies": {
    "express": "5.1.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "prettier": "^3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
